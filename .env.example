# Postgres credentials consumed by docker-compose. The defaults are fine for
# local development; set strong values in any shared or production environment.
POSTGRES_USER=homelab
POSTGRES_PASSWORD=homelab
POSTGRES_DB=homelab

# Postgres connection string used by the API and drizzle-kit. Must match the
# POSTGRES_* values above.
DATABASE_URL=postgres://homelab:homelab@localhost:5432/homelab

# Port the Hono API listens on
PORT=8787
